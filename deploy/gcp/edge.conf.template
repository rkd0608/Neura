# The public front of the Neura VM (deploy/gcp/compose.yaml). neura-apply renders ${DOMAIN}.
#
# Port 443 is shared by routing on the TLS server name before any decryption:
#   agents.<domain>   passed through to the control plane's agent stream, which requires the
#                     agent's client certificate (mutual TLS ends at the control plane, not here)
#   enroll.<domain>   passed through to the enrollment listener
#   anything else     TLS terminated here: <domain> (the site) and console.<domain> (console + API)
# Site agents therefore need outbound 443 only (design §17.1). Every hop carries the PROXY
# protocol so the client's address survives the extra hop.
worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 4096;
}

stream {
    # Docker's resolver, so a restarted container's new address is picked up.
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $ssl_preread_server_name $neura_route {
        agents.${DOMAIN} 127.0.0.1:9081;
        enroll.${DOMAIN} 127.0.0.1:9082;
        default          127.0.0.1:8443;
    }

    server {
        listen 443;
        ssl_preread on;
        proxy_protocol on;
        proxy_pass $neura_route;
        proxy_connect_timeout 5s;
    }

    server {
        listen 127.0.0.1:9081 proxy_protocol;
        set $neura_agents control-plane:8081;
        proxy_pass $neura_agents;
        proxy_connect_timeout 5s;
        # Agents hold one long-lived stream each and reconnect when it ends.
        proxy_timeout 1h;
    }

    server {
        listen 127.0.0.1:9082 proxy_protocol;
        set $neura_enroll control-plane:8082;
        proxy_pass $neura_enroll;
        proxy_connect_timeout 5s;
    }
}

http {
    server_tokens off;
    access_log /dev/stdout combined;
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate /etc/neura/tls/fullchain.pem;
    ssl_certificate_key /etc/neura/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:tls:10m;
    ssl_session_timeout 1h;

    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";

    # Let's Encrypt HTTP-01 challenges; everything else moves to HTTPS.
    server {
        listen 80 default_server;
        location /.well-known/acme-challenge/ {
            root /var/www/acme;
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 127.0.0.1:8443 ssl default_server proxy_protocol;
        http2 on;
        server_name ${DOMAIN};
        location / {
            set $neura_landing landing:8080;
            proxy_pass http://$neura_landing;
        }
    }

    server {
        listen 127.0.0.1:8443 ssl proxy_protocol;
        http2 on;
        server_name console.${DOMAIN};
        # The console's own nginx proxies /v1 to the API and enforces body limits per route.
        client_max_body_size 0;
        location / {
            set $neura_console console:8080;
            proxy_pass http://$neura_console;
            # Server-sent events and large uploads stream through.
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 1h;
        }
    }
}
