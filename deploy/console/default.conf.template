# Neura console: static files plus the management API on the same origin (design §19.6, §20.1).
# Rendered at container start from environment variables by the nginx image (envsubst):
#   NEURA_API_UPSTREAM      e.g. http://control-plane:8080
#   NEURA_CSP_CONNECT_EXTRA extra connect-src origins, e.g. the OIDC issuer (may be empty)
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    include /etc/nginx/conf.d/security-headers.inc;

    location /v1/ {
        proxy_pass ${NEURA_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Server-sent events: deliver as they arrive; streams end on their own after minutes.
        proxy_buffering off;
        proxy_read_timeout 1h;
        # Uploads (sealed weights can be large) stream through; the API enforces its own limits.
        client_max_body_size 0;
        proxy_request_buffering off;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        # Content-hashed file names: safe to cache forever.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri /index.html;
    }
}
